# LLM API配置（支持 OpenAI SDK 格式的任意 LLM API）
# 推荐使用阿里百炼平台qwen-plus模型：https://bailian.console.aliyun.com/
# 注意消耗较大，可先进行小于40轮的模拟尝试
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# LLM JSON output mode (optional, default: json_object)
#   json_object — OpenAI, Ollama, Qwen Cloud, Anthropic-compatible endpoints
#   none        — LM Studio, llama.cpp server, or any runtime that rejects the
#                 `response_format` parameter. Relies on prompt-based JSON + robust parsing.
# LLM_JSON_MODE=json_object

# ===== 记忆后端选择 (Memory backend) =====
# zep      — Zep Cloud SaaS (default; precisa de ZEP_API_KEY)
# graphiti — Graphiti + Neo4j self-hosted (precisa de NEO4J_* configurado e Neo4j rodando)
# Subir Neo4j local: docker compose -f backend/docker-compose.neo4j.yml up -d
MEMORY_BACKEND=zep

# ===== ZEP记忆图谱配置 (usado quando MEMORY_BACKEND=zep) =====
# 每月免费额度即可支撑简单使用：https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== Neo4j配置 (usado quando MEMORY_BACKEND=graphiti) =====
# A senha é obrigatória; defina antes de subir o docker-compose
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_please

# ===== Embeddings local (usado quando MEMORY_BACKEND=graphiti) =====
# Roda em-process via sentence-transformers; carrega o modelo uma vez por
# processo (~2GB RAM, ~5-10s no primeiro request). BGE-M3 é top-tier
# multilingual (MTEB-PT, MIRACL) e produz vetores 1024-d.
SENTENCE_TRANSFORMER_MODEL=BAAI/bge-m3

# Provider LLM para o Graphiti (anthropic | openai)
# - anthropic: usa AnthropicClient nativo (recomendado quando LLM_BASE_URL=api.anthropic.com)
# - openai: usa OpenAIClient default (espera OPENAI_API_KEY ou LLM_BASE_URL OpenAI-compat)
GRAPHITI_LLM_PROVIDER=anthropic

# ===== 加速 LLM 配置（可选）=====
# 注意如果不使用加速配置，env文件中就不要出现下面的配置项
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here
